{
  "name": "dsh-go-bili",
  "version": "0.1.0",
  "private": true,
  "description": "bili-peek —— R4 插件生态：让 Agent 主动查一个 B 站视频的公开信息（BV 号 / 链接 -> 结构化 JSON），结果在 dsh-go 里画成原生卡片；查询记录进状态条与面板，并写进能力台账（installed / loaded / toolRegistered / lastRunOk）。",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./views": "./lib/views.mjs",
    "./bili": "./lib/bili.mjs",
    "./ledger": "./lib/ledger.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node ../../../sdk/plugin-kit/bin/check.mjs ."
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dshGo": {
    "v": 1,
    "title": {
      "zh": "B站速览",
      "en": "Bili peek"
    },
    "icon": "video",
    "contributes": {
      "composer.strip": [
        {
          "id": "peek.strip",
          "icon": "video",
          "panel": "peek"
        }
      ],
      "panels": [
        {
          "id": "peek",
          "title": {
            "zh": "B站速览",
            "en": "Bili peek"
          },
          "icon": "video",
          "placement": [
            "session.tab",
            "chat.panel",
            "features"
          ]
        }
      ]
    }
  },
  "engines": {
    "node": ">=22.19",
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "dependencies": {},
  "peerDependencies": {},
  "peerDependenciesMeta": {}
}
