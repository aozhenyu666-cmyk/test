<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 网络：只连你自己在设置里填的 AI 接口 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 后台心跳：常驻通知（Android 13 起要你同意）+ 前台服务 + 开机后接回来 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 看前台应用：用户在系统“使用情况访问”里手动打开；不开就降级（少看一样，调试页写明） -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <queries>
        <!-- 语音输入走系统识别界面：录音由系统负责，墨灵不申请录音权限 -->
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
        <!-- Android 11 起，不在这里声明就看不见总控，也就读不到它的状态 -->
        <package android:name="com.zongkong.app" />
        <!-- “去聊”时要打开演员：不声明就看不见/打不开 Gemini 和 ChatGPT -->
        <package android:name="com.google.android.apps.bard" />
        <package android:name="com.openai.chatgpt" />
    </queries>

    <application
        android:name=".MolingApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Moling">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 活的墨灵（v5）：拦在娱乐应用前面 / 蹦出来说一句。单独的任务，关掉就回到他原来在用的应用 -->
        <activity
            android:name=".live.GateActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity="com.moling.app.gate"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Moling" />
        <activity
            android:name=".live.PeekActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity="com.moling.app.peek"
            android:windowSoftInputMode="adjustResize"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <service android:name=".overlay.OverlayService" android:exported="false" />
        <!-- 第六批 A 组：桌宠 / 盯着你 / 参谋弹幕 / 褪色 / 演员胶囊都在这一个服务里。 -->
        <service android:name=".live.PetOverlayService" android:exported="false" />
        <!-- 第六批 B1：捉虫题（透明主题，从底部出一张纸卡）。 -->
        <activity
            android:name=".live.QuizActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity="com.moling.app.quiz"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <activity android:name=".overlay.PresenceActivity" android:exported="false" android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <activity android:name=".ShareActivity" android:exported="true" android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- 后台心跳：离开 App 也在。低优先级常驻通知，灭屏时放慢。 -->
        <service
            android:name=".HeartService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="个人 AI 伙伴：每分钟看一眼总控和今天的安排" />
        </service>

        <receiver android:name=".widget.NowWidget" android:exported="false" android:label="墨灵 · 此刻">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_now" />
        </receiver>

        <!-- 开机 / 覆盖安装后，设置里开着就把心跳接回来 -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- 通知上的「好 / 不用」：只接受自己 App 发来的广播 -->
        <receiver
            android:name=".NotifyReceiver"
            android:exported="false" />
    </application>
</manifest>