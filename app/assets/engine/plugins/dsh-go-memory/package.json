{
  "name": "dsh-go-memory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "大肥鱼手机本地记忆：SQLite 权威、作用域、事实纠正/删除、未完成话题、原生记忆面板。",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./model": "./lib/model.js",
    "./store": "./lib/store.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml"],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node ../../../../sdk/plugin-kit/bin/check.mjs ."
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dshGo": {
    "v": 1,
    "title": { "zh": "本地记忆", "en": "Local memory" },
    "icon": "book",
    "contributes": {
      "composer.actions": [
        { "id": "memory-open", "label": { "zh": "记忆", "en": "Memory" }, "icon": "book" }
      ],
      "panels": [
        {
          "id": "memory",
          "title": { "zh": "本地记忆", "en": "Local memory" },
          "icon": "book",
          "placement": ["session.tab", "features", "chat.panel"]
        }
      ]
    }
  },
  "engines": {
    "node": ">=22.13",
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "license": "MIT"
}
