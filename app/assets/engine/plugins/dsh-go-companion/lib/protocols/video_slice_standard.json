{
  "协议版本": 1,
  "id": "video-slice-standard",
  "名称": "视频切片标准拆解局",
  "类型": "行为",
  "需要能力": ["计时", "前台应用", "语音问", "文字", "盖屏", "倒计时条", "留空填词", "挖词回想", "度量判定"],
  "预算": { "分钟": 40, "来回": 16 },
  "步骤": [
    {
      "id": "开片锚点",
      "问": "这一段视频你准备偷哪一招回去改手头流程？先定一句具体目标。",
      "限时": "90s",
      "过关": { "字数": 8, "具体名词数": 1, "模糊词数": 0 },
      "超时": "下一步",
      "不过": "重打",
      "触发": "语音问",
      "应答": "文字"
    },
    {
      "id": "每180秒停播填空",
      "问": "停播回想：刚才 180 秒的机制核心是____，前置约束条件是____。",
      "每": "180s",
      "重复至": "1/4",
      "过关": { "字数": 10, "具体名词数": 1, "不与前次重复": true },
      "超时": "下一步",
      "不过": "重打",
      "触发": "盖屏",
      "形态": "留空填词",
      "应答": "文字"
    },
    {
      "id": "边界与反例拆解",
      "问": "这条做法在什么边界或数据分布下会反过来失灵？写明因果。",
      "限时": "3m",
      "过关": { "字数": 12, "因果连接词数": 1 },
      "超时": "下一步",
      "不过": "重打",
      "触发": "倒计时条",
      "形态": "挖词回想",
      "应答": "文字"
    },
    {
      "id": "入卡挂载",
      "问": "写出这招落回你当前任务的 1 步改动，并写明收工检验标准。",
      "限时": "3m",
      "过关": { "字数": 12, "具体名词数": 1 },
      "超时": "收局",
      "不过": "重打",
      "触发": "语音问",
      "应答": "文字"
    }
  ],
  "收局": {
    "交": ["边界与反例拆解", "入卡挂载"],
    "判定": "每 180 秒强制停播防被动浸泡；收局须带反例与真实挂载步入库 Obsidian"
  }
}
