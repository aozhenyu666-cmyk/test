{
  "协议版本": 1,
  "id": "video-slice-dice",
  "名称": "视频切片拆解局",
  "类型": "行为",
  "需要能力": ["计时", "前台应用", "语音问", "文字", "盖屏", "倒计时条", "留空填词", "挖词回想", "度量判定"],
  "预算": { "分钟": 45, "来回": 16 },
  "步骤": [
    {
      "id": "立标",
      "问": "这段视频要拿走哪一招？写一句。",
      "限时": "2m",
      "过关": { "字数": 8, "具体名词数": 1 },
      "超时": "下一步",
      "不过": "重打",
      "触发": "语音问",
      "应答": "文字"
    },
    {
      "id": "切片填空",
      "问": "刚才那段讲了____，条件是____。",
      "每": "180s",
      "重复至": "1/4",
      "过关": { "字数": 10, "具体名词数": 1, "不与前次重复": true },
      "超时": "下一步",
      "不过": "重打",
      "触发": "盖屏",
      "形态": "留空填词",
      "应答": "文字"
    },
    {
      "id": "反例检验",
      "问": "哪一个前提变了，这招就会失效？",
      "限时": "4m",
      "过关": { "字数": 12, "因果连接词数": 1 },
      "超时": "下一步",
      "不过": "重打",
      "触发": "倒计时条",
      "形态": "挖词回想",
      "应答": "文字"
    },
    {
      "id": "入卡挂载",
      "问": "这招能直接改你手头哪一步？",
      "限时": "4m",
      "过关": { "字数": 10, "具体名词数": 1 },
      "超时": "收局",
      "不过": "重打",
      "触发": "语音问",
      "应答": "文字"
    }
  ],
  "收局": {
    "交": ["反例检验", "入卡挂载"],
    "判定": "每 180 秒停播填空；收局输出失效条件与手头项目挂钩句写入 Obsidian"
  }
}
