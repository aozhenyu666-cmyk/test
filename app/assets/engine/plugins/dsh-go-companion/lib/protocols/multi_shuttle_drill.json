{
  "协议版本": 1,
  "id": "multi-shuttle-drill",
  "名称": "羽毛球多球快打练兵局",
  "类型": "思维",
  "需要能力": ["计时", "语音问", "文字", "先答后看", "倒计时条", "度量判定"],
  "预算": { "分钟": 25, "来回": 14 },
  "步骤": [
    {
      "id": "第一球-锚定靶面",
      "问": "多球发球：本局只解决哪一个卡点或概念机制？说清楚边界与失败信号。",
      "限时": "90s",
      "过关": { "字数": 12, "具体名词数": 1, "模糊词数": 0 },
      "超时": "下一步",
      "不过": "重打",
      "触发": "先答后看",
      "应答": "文字"
    },
    {
      "id": "第二球-机制重述",
      "问": "不看原文：用「输入 -> 机制/条件 -> 输出」讲清原理，不要只背结论词。",
      "限时": "2m",
      "过关": { "字数": 16, "具体名词数": 1, "不与前次重复": true },
      "超时": "下一步",
      "不过": "重打",
      "触发": "倒计时条",
      "应答": "文字"
    },
    {
      "id": "第三球-判因对比",
      "问": "对比相邻概念或错因：前提不同时，各自为什么导致不同结果？",
      "限时": "2m",
      "过关": { "字数": 14, "因果连接词数": 1, "模糊词数": 0 },
      "超时": "下一步",
      "不过": "重打",
      "触发": "语音问",
      "应答": "文字"
    },
    {
      "id": "第四球-反例证伪",
      "问": "给出至少一个具体反例或极限场景，说明该结论何时必然失效。",
      "限时": "2m",
      "过关": { "字数": 12, "因果连接词数": 1, "具体名词数": 1 },
      "超时": "下一步",
      "不过": "重打",
      "触发": "语音问",
      "应答": "文字"
    },
    {
      "id": "第五球-盲演迁移",
      "问": "闭书盲演：写出可执行 3 步动作并附带 1 项量化验收指标。",
      "限时": "3m",
      "过关": { "字数": 14, "具体名词数": 1, "有无结论句": true },
      "超时": "收局",
      "不过": "重打",
      "触发": "倒计时条",
      "应答": "文字"
    }
  ],
  "收局": {
    "交": ["第四球-反例证伪", "第五球-盲演迁移"],
    "判定": "零脚手架快节奏抽问完成：必须产出机制说明、反例边界与可量化迁移步"
  }
}
