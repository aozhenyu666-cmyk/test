{
  "schemaVersion": 1,
  "name": "Deepy 小鲸鱼",
  "author": "Deepy whale fan theme",
  "version": "1.0.0",
  "description": "Pixel whale desktop pet for DeepSeek-powered agents — squishy, bouncy, 20 animations. Unofficial fan theme.",
  "customization": {
    "petTint": true
  },
  "viewBox": {
    "x": 0,
    "y": 0,
    "width": 52,
    "height": 52
  },
  "layout": {
    "contentBox": {
      "x": 12,
      "y": 27,
      "width": 32,
      "height": 22
    },
    "centerX": 27,
    "baselineY": 48.5,
    "visibleHeightRatio": 0.4,
    "baselineBottomRatio": 0.05
  },
  "eyeTracking": {
    "enabled": true,
    "states": [
      "idle"
    ],
    "eyeRatioX": 0.38,
    "eyeRatioY": 0.74,
    "maxOffset": 1.2,
    "bodyScale": 0.4,
    "shadowStretch": 0.12,
    "shadowShift": 0.3,
    "ids": {
      "eyes": "eyes-js",
      "body": "body-js",
      "shadow": "shadow-js"
    },
    "shadowOrigin": "26px 48px"
  },
  "states": {
    "idle": [
      "idle-follow.svg"
    ],
    "thinking": [
      "thinking.apng"
    ],
    "working": [
      "typing.apng"
    ],
    "juggling": [
      "music.apng"
    ],
    "error": [
      "error.apng"
    ],
    "attention": [
      "happy.apng"
    ],
    "notification": [
      "notification.apng"
    ],
    "sweeping": [
      "compacting.apng"
    ],
    "carrying": [
      "carrying.apng"
    ],
    "sleeping": [
      "sleeping.apng"
    ],
    "waking": [
      "waking.apng"
    ],
    "roam": [
      "roam-hop.apng"
    ]
  },
  "roamFlipAssets": true,
  "sleepSequence": {
    "mode": "direct"
  },
  "workingTiers": [
    {
      "minSessions": 3,
      "file": "building.apng"
    },
    {
      "minSessions": 2,
      "file": "music.apng"
    },
    {
      "minSessions": 1,
      "file": "typing.apng"
    }
  ],
  "jugglingTiers": [
    {
      "minSessions": 2,
      "file": "conducting.apng"
    },
    {
      "minSessions": 1,
      "file": "music.apng"
    }
  ],
  "idleAnimations": [
    {
      "file": "idle.apng",
      "duration": 4800
    },
    {
      "file": "idle-look.apng",
      "duration": 6800
    },
    {
      "file": "idle-spout.apng",
      "duration": 6400
    }
  ],
  "timings": {
    "minDisplay": {
      "attention": 5200,
      "error": 4800,
      "sweeping": 5600,
      "notification": 3200,
      "carrying": 3200,
      "working": 1000,
      "thinking": 1000
    },
    "autoReturn": {
      "attention": 5200,
      "error": 4800,
      "sweeping": 300000,
      "notification": 3200,
      "carrying": 3200
    },
    "wakeDuration": 1500,
    "mouseIdleTimeout": 20000,
    "mouseSleepTimeout": 60000
  },
  "hitBoxes": {
    "default": {
      "x": 12,
      "y": 30,
      "w": 30,
      "h": 18
    },
    "sleeping": {
      "x": 12,
      "y": 30,
      "w": 30,
      "h": 18
    },
    "wide": {
      "x": 6,
      "y": 14,
      "w": 40,
      "h": 34
    }
  },
  "sleepingHitboxFiles": [
    "sleeping.apng"
  ],
  "wideHitboxFiles": [
    "error.apng",
    "notification.apng",
    "happy.apng",
    "conducting.apng",
    "building.apng",
    "typing.apng",
    "thinking.apng"
  ],
  "fileHitBoxes": {
    "react-drag.apng": {
      "x": 10,
      "y": 6,
      "w": 34,
      "h": 30
    }
  },
  "reactions": {
    "drag": {
      "file": "react-drag.apng"
    },
    "clickLeft": {
      "file": "react-left.apng",
      "duration": 2000
    },
    "clickRight": {
      "file": "react-right.apng",
      "duration": 2000
    },
    "double": {
      "files": [
        "react-double.apng"
      ],
      "duration": 2400
    }
  },
  "miniMode": {
    "supported": false
  }
}