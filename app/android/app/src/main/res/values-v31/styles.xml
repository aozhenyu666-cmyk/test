<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Android 12+ always shows the system splash. This theme can't know which 桌面图标 is on
         the launcher (an activity-alias has no theme), so its splash has no icon: the page colour
         alone, which Dart's first frame repeats before it brings the chosen icon in. Android 13+
         is given the chosen icon's own theme below for its next launches
         (launch/LaunchThemes.kt). -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="28">shortEdges</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="29">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="29">false</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/launch_background_top</item>
        <!-- Not the splash colour itself: the icon themes below (windowSplashScreenAnimatedIcon)
             would then be drawn 1.2x larger (192dp) than the 160dp square the app's first frame
             uses (launch/LaunchGeometry.kt). Not drawn behind an adaptive icon (colors.xml). -->
        <item name="android:windowSplashScreenIconBackgroundColor">@color/launch_icon_ground</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/launch_icon_none</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="28">shortEdges</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="29">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="29">false</item>
        <item name="android:windowBackground">@color/launch_background_top</item>
    </style>

    <!-- Android 13+ (SplashScreen.setSplashScreenTheme, launch/LaunchThemes.kt): the splash of
         the next launches. Each 桌面图标's own icon, the same one its activity-alias names. -->
    <style name="LaunchTheme.Mist">
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
    </style>
    <style name="LaunchTheme.Night">
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_night</item>
    </style>
    <style name="LaunchTheme.Frost">
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_frost</item>
    </style>
    <style name="LaunchTheme.Ink">
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_ink</item>
    </style>
    <!-- A custom launch screen on white or black: no icon, that colour (the picture fades in over it). -->
    <style name="LaunchTheme.White">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:windowSplashScreenBackground">@android:color/white</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/white</item>
    </style>
    <style name="LaunchTheme.Black">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowSplashScreenBackground">@android:color/black</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/black</item>
    </style>
</resources>
