<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 总控掉线时提醒你 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 自己把总控的无障碍服务重新挂上：要在电脑上 adb 授权一次；不授权就只拦、只提醒 -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- 只需要看见总控（判断装没装、叫醒它） -->
    <queries>
        <package android:name="com.zongkong.app" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".BlockActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="com.zongkong.sentinel.block" />

        <!-- 总控往这里写心跳和拦截状态；只认总控的签名 -->
        <provider
            android:name=".LinkProvider"
            android:authorities="com.zongkong.sentinel.link"
            android:exported="true" />

        <service
            android:name=".SentinelService"
            android:exported="true"
            android:label="@string/service_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/sentinel_service" />
        </service>
    </application>
</manifest>
