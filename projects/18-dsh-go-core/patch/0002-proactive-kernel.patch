@@ -0,0 +1,13 @@
+{
+  "name": "dsh-go-proactive",
+  "version": "0.1.0",
+  "description": "dsh-go host plugin: hands a proactive phone event to a live DSH agent as one followup turn and reports accepted / claimed / generated / failed / cancelled, never more than happened.",
+  "type": "module",
+  "main": "lib/index.js",
+  "exports": { ".": "./lib/index.js", "./core": "./lib/core.js", "./package.json": "./package.json" },
+  "files": ["lib/index.js", "lib/core.js", "cordis.patch.yml"],
+  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
+  "engines": { "node": ">=20" },
+  "scripts": { "test": "node --test test/core.test.mjs" },
+  "license": "AGPL-3.0-only"
+}
diff --git a/runtime/proactive/dsh-go-proactive/test/core.test.mjs b/runtime/proactive/dsh-go-proactive/test/core.test.mjs
new file mode 100644
index 0000000..8033a29
--- /dev/null
+++ b/runtime/proactive/dsh-go-proactive/test/core.test.mjs
@@ -0,0 +1,149 @@
+// Unit tests for lib/core.js with a fake agent and hand-written session events
+// (shapes copied from @deepseek-ai/dsh-agent-loop 0.2.1-rc.4). Run: node --test test/core.test.mjs
+import { test } from 'node:test'
+import assert from 'node:assert/strict'
+import { Desk, validateRequest, assistantText, composeText } from '../lib/core.js'
+
+function setup({ status = 'idle', throws, rejects } = {}) {
+  let now = 1_000
+  let n = 0
+  const sent = []
+  const agent = {
+    id: 'session-a', status, inbox: { hasPending: false },
+    followup(m) {
+      if (throws) throw new Error('boom')
+      sent.push(m)
+      return rejects ? Promise.reject(new Error('later')) : undefined
+    },
+  }
+  const desk = new Desk({
+    findAgent: (id) => (id === 'session-a' ? agent : undefined),
+    makeMessage: (text) => ({ id: `m${++n}`, role: 'user', content: [{ type: 'text', text }], source: { kind: 'dsh-go-proactive' } }),
+    now: () => now,
+    defaultSession: () => 'session-a',
+  })
+  return { desk, agent, sent, tick: (ms) => { now += ms } }
+}
+const req = (i, extra = {}) => ({ v: 1, requestId: `request-${i}`, eventId: `event-00${i}`, kind: 'app_enter', payload: { packageName: 'com.x' }, ...extra })
+const say = (turn, text, extra = {}) => ({ type: 'assistant/message', data: { turn, step: 0, message: { content: [{ type: 'text', text }] }, ...extra } })
+function runTurn(desk, msgId, turn, events) {
+  desk.onSessionEvent('session-a', { type: 'turn/start', data: { turn } })
+  desk.onSessionEvent('session-a', { type: 'user/message', data: { id: msgId, role: 'user' } })
+  for (const e of events) desk.onSessionEvent('session-a', e)
+}
+
+test('validation', () => {
+  assert.equal(validateRequest(null).error.code, 'bad-request')
+  assert.equal(validateRequest({ requestId: 'x', eventId: 'event-001' }).error.code, 'bad-request-id')
+  assert.equal(validateRequest({ ...req(1), v: 2 }).error.code, 'unsupported-version')
+  assert.equal(validateRequest({ ...req(1), payload: { a: 1 } }).error.code, 'bad-payload')
+  assert.equal(validateRequest({ ...req(1), deadlineMs: 1 }).value.deadlineMs, 5000)
+  assert.equal(validateRequest({ ...req(1), deadlineMs: 10 ** 9 }).value.deadlineMs, 120000)
+})
+
+test('accepted → claimed → generated, with the last visible text of that turn', () => {
+  const { desk, sent } = setup()
+  const a = desk.request(req(1))
+  assert.equal(a.status, 202)
+  assert.equal(a.body.state, 'accepted')
+  assert.equal(sent.length, 1)
+  assert.ok(sent[0].content[0].text.includes('packageName=com.x'))
+  runTurn(desk, sent[0].id, 4, [
+    say(4, ''), // a tool-call step without text
+    { type: 'assistant/message', data: { turn: 3, message: { content: [{ type: 'text', text: 'other turn' }] } } },
+    say(4, '你好'),
+  ])
+  assert.equal(desk.result('request-1').body.state, 'claimed')
+  assert.equal(desk.result('request-1').body.text, null, 'no text before the turn ends')
+  desk.onSessionEvent('session-a', { type: 'turn/end', data: { turn: 4, reason: { kind: 'completed' } } })
+  const r = desk.result('request-1').body
+  assert.equal(r.state, 'generated')
+  assert.equal(r.text, '你好')
+  assert.equal(r.turn, 4)
+})
+
+test('a completed turn without text, an error, an abort, an interruption all fail', () => {
+  for (const [events, code] of [
+    [[], 'no-text'],
+    [[say(1, 'half')], 'turn-error', 'error'],
+    [[say(1, 'half')], 'turn-aborted', 'aborted'],
+    [[say(1, 'half', { interrupted: true })], 'no-text'],
+  ].map(([e, c, k]) => [[...e, { type: 'turn/end', data: { turn: 1, reason: { kind: k ?? 'completed', error: { message: 'x' } } } }], c])) {
+    const { desk, sent } = setup()
+    desk.request(req(1))
+    runTurn(desk, sent[0].id, 1, events)
+    const r = desk.result('request-1').body
+    assert.equal(r.state, 'failed')
+    assert.equal(r.failure.code, code)
+    assert.equal(r.text, null)
+  }
+})
+
+test('one followup per requestId and per eventId; one request at a time', () => {
+  const { desk, sent } = setup()
+  desk.request(req(1))
+  assert.equal(desk.request(req(1)).status, 200, 'replay reports')
+  assert.equal(desk.request({ ...req(1), eventId: 'event-009' }).body.error.code, 'request-id-conflict')
+  assert.equal(desk.request({ ...req(2), eventId: 'event-001' }).body.error.code, 'event-in-flight')
+  assert.equal(desk.request(req(3)).body.error.code, 'desk-busy')
+  assert.equal(sent.length, 1)
+})
+
+test('busy, missing, archived and throwing agents are refused without sending', () => {
+  assert.equal(setup({ status: 'running' }).desk.request(req(1)).body.error.code, 'agent-busy')
+  const pend = setup(); pend.agent.inbox.hasPending = true
+  assert.equal(pend.desk.request(req(1)).body.error.code, 'agent-busy')
+  assert.equal(setup().desk.request(req(1, { sessionId: 'session-zzz' })).body.error.code, 'no-agent')
+  const t = setup({ throws: true })
+  assert.equal(t.desk.request(req(1)).body.error.code, 'followup-failed')
+  assert.equal(t.desk.result('request-1').status, 404, 'nothing recorded')
+  const noSession = new Desk({ findAgent: () => undefined, makeMessage: () => ({ id: 'm' }) })
+  assert.equal(noSession.request(req(1)).body.error.code, 'no-session')
+  const arch = new Desk({ findAgent: () => ({ status: 'idle', followup() {} }), makeMessage: () => ({ id: 'm' }), isArchived: () => true, defaultSession: () => 's' })
+  assert.equal(arch.request(req(1)).body.error.code, 'archived')
+})
+
+test('a rejected followup promise fails the record instead of crashing the host', async () => {
+  const { desk } = setup({ rejects: true })
+  assert.equal(desk.request(req(1)).status, 202)
+  await new Promise((r) => setImmediate(r))
+  assert.equal(desk.result('request-1').body.failure.code, 'followup-rejected')
+})
+
+test('cancelled records never hand out text that arrives later', () => {
+  const { desk, sent } = setup()
+  desk.request(req(1))
+  runTurn(desk, sent[0].id, 2, [])
+  assert.equal(desk.cancel('request-1').body.state, 'cancelled')
+  desk.onSessionEvent('session-a', say(2, 'late'))
+  desk.onSessionEvent('session-a', { type: 'turn/end', data: { turn: 2, reason: { kind: 'completed' } } })
+  const r = desk.result('request-1').body
+  assert.equal(r.state, 'cancelled')
+  assert.equal(r.text, null)
+  assert.equal(desk.counters.lateText, 1)
+  assert.equal(desk.request(req(2)).status, 202, 'the desk is free again')
+})
+
+test('deadline and agent going away fail open records', () => {
+  const a = setup()
+  a.desk.request(req(1))
+  a.tick(45_000)
+  assert.equal(a.desk.result('request-1').body.failure.code, 'deadline')
+  const b = setup()
+  b.desk.request(req(1))
+  b.desk.onAgentGone('session-a')
+  assert.equal(b.desk.result('request-1').body.failure.code, 'agent-gone')
+})
+
+test('long poll wakes on change', async () => {
+  const { desk, sent } = setup()
+  desk.request(req(1))
+  const p = desk.wait('request-1', 5000)
+  runTurn(desk, sent[0].id, 1, [])
+  assert.equal((await p).body.state, 'claimed')
+})
+
+test('helpers', () => {
+  assert.equal(assistantText({ message: { content: [{ type: 'reasoning', text: 'x' }, { type: 'text', text: ' a ' }, { type: 'tool-call' }] } }), 'a')
+  assert.ok(composeText({ kind: 'k', payload: { a: 'b' } }, 'I').endsWith('kind=k\na=b'))
+})
diff --git a/runtime/proactive/dsh-go-proactive/test/e2e-live.mjs b/runtime/proactive/dsh-go-proactive/test/e2e-live.mjs
new file mode 100644
index 0000000..1e09565
--- /dev/null
+++ b/runtime/proactive/dsh-go-proactive/test/e2e-live.mjs
@@ -0,0 +1,147 @@
+// Live end-to-end check of dsh-go-proactive against a real DSH engine (`dsh web`) whose model is
+// a local Messages-API mock (test/mock-messages.mjs). Offline: nothing leaves 127.0.0.1.
+//
+//   node test/e2e-live.mjs <dsh-bin> <port> <mock-port> <mock-log>
+//
+// Checks, in order: guard, no session, real followup turn → generated text that came from the
+// model, replay of the same requestId (no second model call), same eventId in flight, agent busy,
+// cancel while the turn runs (late text never handed out), deadline.
+import { spawn } from 'node:child_process'
+import { readFileSync, writeFileSync, mkdtempSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join, dirname } from 'node:path'
+import { fileURLToPath } from 'node:url'
+import { request as httpRequest } from 'node:http'
+
+const [dshBin, portArg, mockPortArg, mockLog] = process.argv.slice(2)
+const port = Number(portArg)
+const here = dirname(fileURLToPath(import.meta.url))
+const pluginIndex = join(here, '..', 'lib', 'index.js')
+const fixtureIndex = join(here, 'fixture-session', 'index.js')
+const work = mkdtempSync(join(tmpdir(), 'proactive-e2e-'))
+const patch = join(work, 'proactive.patch.yml')
+writeFileSync(patch, `- insert:\n    - id: dsh-go-proactive\n      name: ${pluginIndex}\n    - id: proactive-fixture\n      name: ${fixtureIndex}\n`)
+
+let failures = 0
+const check = (ok, what) => { console.log(`${ok ? 'PASS' : 'FAIL'} ${what}`); if (!ok) failures++ }
+const mockCalls = () => { try { return readFileSync(mockLog, 'utf8').trim().split('\n').filter((l) => l.includes('/messages')).length } catch { return 0 } }
+
+const child = spawn(dshBin, ['--profile', 'web', '--patch', patch, '--no-open', '--host', '127.0.0.1', '--port', String(port)], {
+  env: { ...process.env, DSH_HOME: join(work, 'home'), DEEPSEEK_API_KEY: 'sk-mock-0000000000000000', DEEPSEEK_BASE_URL: `http://127.0.0.1:${mockPortArg}/anthropic`, NO_PROXY: '127.0.0.1,localhost', no_proxy: '127.0.0.1,localhost', FIXTURE_CWD: work },
+  stdio: ['ignore', 'pipe', 'pipe'],
+})
+let out = ''
+child.stdout.on('data', (d) => { out += d })
+child.stderr.on('data', (d) => { out += d })
+
+function http(method, path, { body, cookie } = {}) {
+  return new Promise((resolve, reject) => {
+    const data = body === undefined ? undefined : Buffer.from(JSON.stringify(body))
+    const req = httpRequest({ host: '127.0.0.1', port, method, path, headers: {
+      ...(cookie ? { cookie } : {}), ...(data ? { 'content-type': 'application/json', 'content-length': data.length } : {}),
+    } }, (res) => {
+      let t = ''
+      res.on('data', (c) => { t += c })
+      res.on('end', () => { let j; try { j = JSON.parse(t) } catch { j = t } resolve({ status: res.statusCode, headers: res.headers, body: j }) })
+    })
+    req.on('error', reject)
+    if (data) req.write(data)
+    req.end()
+  })
+}
+const sleep = (ms) => new Promise((r) => setTimeout(r, ms))
+
+try {
+  let token = ''
+  for (let i = 0; i < 240 && !token; i++) {
+    const m = out.match(/dsh web: http:\/\/127\.0\.0\.1:\d+\/\?token=([A-Za-z0-9_-]+)/)
+    if (m) token = m[1]; else await sleep(500)
+  }
+  check(!!token, 'dsh web started and printed a launch token')
+  if (!token) throw new Error(out.slice(-2000))
+  const login = await http('GET', `/?token=${token}`)
+  const cookie = [].concat(login.headers['set-cookie'] ?? []).find((c) => c.startsWith('dsh-auth-'))?.split(';')[0]
+  check(!!cookie, 'logged in with the launch token')
+  const C = { cookie }
+  const P = '/dsh-go-proactive/v1'
+
+  check((await http('GET', `${P}/status`)).status === 401, 'routes refuse requests without credentials (401)')
+  const st = await http('GET', `${P}/status`, C)
+  check(st.status === 200 && st.body.v === 1, 'status with cookie')
+
+  const noSession = await http('POST', `${P}/request`, { ...C, body: { v: 1, requestId: 'req-00000001', eventId: 'evt-00000001', kind: 'app_enter', payload: {} } })
+  check(noSession.status === 409 && noSession.body.error.code === 'no-session', `no configured session → 409 no-session (${noSession.status} ${noSession.body?.error?.code})`)
+
+  const created = await http('POST', '/fixture/create-session', C)
+  const sessionId = created.body.sessionId
+  check(created.status === 200 && typeof sessionId === 'string', `fixture created a live session ${sessionId}`)
+  const ghost = await http('POST', `${P}/request`, { ...C, body: { requestId: 'req-ghost001', eventId: 'evt-ghost001', sessionId: 'session-does-not-exist' } })
+  check(ghost.status === 409 && ghost.body.error.code === 'no-agent', 'unknown session → 409 no-agent (never created or woken)')
+  check((await http('POST', `${P}/config`, { ...C, body: { sessionId } })).status === 200, 'configured the target session')
+
+  // A real turn.
+  const before = mockCalls()
+  const req1 = { v: 1, requestId: 'req-00000002', eventId: 'evt-00000002', kind: 'app_enter', payload: { packageName: 'com.example.test', localTime: '09:15' }, deadlineMs: 60000 }
+  const a = await http('POST', `${P}/request`, { ...C, body: req1 })
+  check(a.status === 202 && a.body.state === 'accepted', `request → 202 accepted (${a.status} ${a.body.state})`)
+  let r = a
+  for (let i = 0; i < 10 && r.body.state !== 'generated' && r.body.state !== 'failed'; i++) {
+    r = await http('GET', `${P}/result?requestId=req-00000002&waitMs=10000`, C)
+  }
+  check(r.body.state === 'generated', `turn ended → generated (${r.body.state} ${JSON.stringify(r.body.failure)})`)
+  check(typeof r.body.text === 'string' && r.body.text.startsWith('MOCK_REPLY: 你好'), `text is the model's reply: ${r.body.text}`)
+  check(r.body.claimedAt !== null && Number.isInteger(r.body.turn), `claimed into turn ${r.body.turn}`)
+  const sent = readFileSync(mockLog, 'utf8').trim().split('\n').slice(before).join('\n')
+  check(sent.includes('dsh-go-proactive') || sent.includes('com.example.test'), 'the model request carried the event facts')
+
+  // Replay: same requestId → same record, no second model call.
+  const callsAfter = mockCalls()
+  const replay = await http('POST', `${P}/request`, { ...C, body: req1 })
+  check(replay.status === 200 && replay.body.state === 'generated', 'replaying the requestId reports the record (200), does not resend')
+  const conflict = await http('POST', `${P}/request`, { ...C, body: { ...req1, eventId: 'evt-other0001' } })
+  check(conflict.status === 409 && conflict.body.error.code === 'request-id-conflict', 'same requestId, other eventId → 409')
+  await sleep(500)
+  check(mockCalls() === callsAfter, 'no extra model call from the replay')
+
+  // Busy and cancel: slow the model down via the mock's control file.
+  writeFileSync(join(dirname(mockLog), 'delay'), '4000')
+  const b = await http('POST', `${P}/request`, { ...C, body: { ...req1, requestId: 'req-00000003', eventId: 'evt-00000003' } })
+  check(b.status === 202, 'second event accepted while idle')
+  const sameEvent = await http('POST', `${P}/request`, { ...C, body: { ...req1, requestId: 'req-00000004', eventId: 'evt-00000003' } })
+  check(sameEvent.status === 409 && sameEvent.body.error.code === 'event-in-flight', 'same eventId with a new requestId while in flight → 409 event-in-flight')
+  await sleep(800)
+  const busy = await http('POST', `${P}/request`, { ...C, body: { ...req1, requestId: 'req-00000005', eventId: 'evt-00000005' } })
+  check(busy.status === 409 && ['agent-busy', 'desk-busy'].includes(busy.body.error.code), `another event while a turn runs → 409 ${busy.body.error?.code}`)
+  const c = await http('POST', `${P}/cancel`, { ...C, body: { requestId: 'req-00000003' } })
+  check(c.body.state === 'cancelled', 'cancel while the turn runs → cancelled')
+  await sleep(5000)
+  const late = await http('GET', `${P}/result?requestId=req-00000003`, C)
+  check(late.body.state === 'cancelled' && late.body.text === null, 'the turn finished later but its text is never handed out')
+  const counters = (await http('GET', `${P}/status`, C)).body.counters
+  check(counters.lateText >= 1, `late text was seen and dropped (lateText=${counters.lateText})`)
+
+  // The person is talking to the agent themselves: a proactive request must not queue behind it.
+  writeFileSync(join(dirname(mockLog), 'delay'), '3000')
+  const typed = await http('POST', '/fixture/user-says', { ...C, body: { sessionId, text: 'hello from the person' } })
+  check(typed.status === 200, 'fixture: the person sends a message (agent starts a turn)')
+  await sleep(500)
+  const userBusy = await http('POST', `${P}/request`, { ...C, body: { ...req1, requestId: 'req-00000007', eventId: 'evt-00000007' } })
+  check(userBusy.status === 409 && userBusy.body.error.code === 'agent-busy', `agent running the person's turn → 409 agent-busy (${userBusy.body.error?.code})`)
+  await sleep(3500)
+
+  // Deadline: model slower than the request's deadline.
+  writeFileSync(join(dirname(mockLog), 'delay'), '9000')
+  const d = await http('POST', `${P}/request`, { ...C, body: { ...req1, requestId: 'req-00000006', eventId: 'evt-00000006', deadlineMs: 5000 } })
+  check(d.status === 202, 'slow request accepted')
+  let dr = d
+  for (let i = 0; i < 4 && !['failed', 'generated'].includes(dr.body.state); i++) dr = await http('GET', `${P}/result?requestId=req-00000006&waitMs=3000`, C)
+  check(dr.body.state === 'failed' && dr.body.failure?.code === 'deadline', `deadline passed → failed/deadline (${dr.body.state} ${dr.body.failure?.code})`)
+  writeFileSync(join(dirname(mockLog), 'delay'), '0')
+} catch (e) {
+  failures++
+  console.log('FAIL', e?.stack ?? e)
+} finally {
+  child.kill('SIGTERM')
+  console.log(failures === 0 ? 'ALL PASS' : `${failures} FAILED`)
+  setTimeout(() => process.exit(failures === 0 ? 0 : 1), 500)
+}
diff --git a/runtime/proactive/dsh-go-proactive/test/fixture-session/index.js b/runtime/proactive/dsh-go-proactive/test/fixture-session/index.js
new file mode 100644
index 0000000..3e3044e
--- /dev/null
+++ b/runtime/proactive/dsh-go-proactive/test/fixture-session/index.js
@@ -0,0 +1,34 @@
+// TEST ONLY: creates one live session on request so the end-to-end test has an idle agent.
+// The production plugin never creates or wakes sessions.
+export const name = 'dsh-go-proactive-fixture'
+export function apply(ctx) {
+  ctx.inject(['webServer'], (webCtx) => {
+    // Simulates the person typing into the session (a plain user message, like the composer).
+    webCtx.effect(() => webCtx.webServer.register({
+      kind: 'exact', path: '/fixture/user-says',
+      handler: async (req, res) => {
+        const denied = ctx.get('connection')?.requestRejection(req)
+        if (denied !== undefined) { res.writeHead(denied); res.end(); return }
+        let t = ''; for await (const c of req) t += c
+        const { sessionId, text } = JSON.parse(t)
+        const agent = ctx.get('agents').get(sessionId)
+        agent.followup({ id: crypto.randomUUID(), role: 'user', content: [{ type: 'text', text }], source: { kind: 'user' } })
+        res.writeHead(200, { 'content-type': 'application/json' }); res.end('{}')
+      },
+    }))
+    webCtx.effect(() => webCtx.webServer.register({
+      kind: 'exact', path: '/fixture/create-session',
+      handler: async (req, res) => {
+        const denied = ctx.get('connection')?.requestRejection(req)
+        if (denied !== undefined) { res.writeHead(denied); res.end(); return }
+        try {
+          const sc = ctx.get('sessionController')
+          const r = await sc.create({ cwd: process.env.FIXTURE_CWD || '/tmp' })
+          res.writeHead(200, { 'content-type': 'application/json' }); res.end(JSON.stringify(r))
+        } catch (e) {
+          res.writeHead(500, { 'content-type': 'application/json' }); res.end(JSON.stringify({ error: String(e?.stack ?? e) }))
+        }
+      },
+    }))
+  })
+}
diff --git a/runtime/proactive/dsh-go-proactive/test/mock-messages.mjs b/runtime/proactive/dsh-go-proactive/test/mock-messages.mjs
new file mode 100644
index 0000000..9fa7193
--- /dev/null
+++ b/runtime/proactive/dsh-go-proactive/test/mock-messages.mjs
@@ -0,0 +1,36 @@
+// Minimal Anthropic-Messages-compatible mock for driving a real DSH engine offline.
+// Every request is appended to requests.jsonl; replies are canned text, streamed as SSE.
+import { createServer } from 'node:http'
+import { appendFileSync } from 'node:fs'
+const port = Number(process.env.PORT || 18900)
+const log = process.env.LOG || 'requests.jsonl'
+import { readFileSync } from 'node:fs'
+import { dirname, join } from 'node:path'
+const delayFile = join(dirname(log), 'delay')
+const delayMs = () => { try { return Number(readFileSync(delayFile, 'utf8')) || 0 } catch { return 0 } }
+createServer(async (req, res) => {
+  let body = ''
+  for await (const c of req) body += c
+  appendFileSync(log, JSON.stringify({ at: Date.now(), method: req.method, url: req.url, body: body.slice(0, 20000) }) + '\n')
+  if (req.method === 'GET' && req.url.includes('/models')) {
+    res.writeHead(200, { 'content-type': 'application/json' }); res.end(JSON.stringify({ data: [{ id: 'deepseek-chat', type: 'model' }] })); return
+  }
+  if (!req.url.includes('/messages')) { res.writeHead(404); res.end(); return }
