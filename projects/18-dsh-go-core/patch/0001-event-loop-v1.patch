diff --git a/app/lib/loop/loop_channel.dart b/app/lib/loop/loop_channel.dart
new file mode 100644
index 0000000..e93a399
--- /dev/null
+++ b/app/lib/loop/loop_channel.dart
@@ -0,0 +1,175 @@
+// Dart side of the `dsh/loop` method channel (android/.../loop/LoopPlugin.kt):
+// 设置 → 手机操控 → 触发测试, the first closed loop.
+
+import 'package:flutter/services.dart';
+
+class LoopConfig {
+  const LoopConfig({this.enabled = false, this.targetPackage, this.cooldownMs = 60000, this.timeoutMs = 60000});
+
+  final bool enabled;
+  final String? targetPackage;
+  final int cooldownMs;
+  final int timeoutMs;
+
+  static LoopConfig fromWire(Object? raw) {
+    final m = raw is Map ? raw : const {};
+    return LoopConfig(
+      enabled: m['enabled'] == true,
+      targetPackage: m['targetPackage'] is String ? m['targetPackage'] as String : null,
+      cooldownMs: m['cooldownMs'] is num ? (m['cooldownMs'] as num).toInt() : 60000,
+      timeoutMs: m['timeoutMs'] is num ? (m['timeoutMs'] as num).toInt() : 60000,
+    );
+  }
+}
+
+class LoopStatus {
+  const LoopStatus({
+    this.config = const LoopConfig(),
+    this.a11yEnabled = false,
+    this.a11yConnected = false,
+    this.eventsSeen = 0,
+    this.readings = 0,
+    this.lastForeground,
+    this.storageError,
+    this.insideTarget = false,
+  });
+
+  final LoopConfig config;
+  final bool a11yEnabled;
+  final bool a11yConnected;
+  final int eventsSeen;
+  final int readings;
+  final String? lastForeground;
+  final String? storageError;
+  final bool insideTarget;
+
+  static LoopStatus fromWire(Object? raw) {
+    final m = raw is Map ? raw : const {};
+    int n(Object? v) => v is num ? v.toInt() : 0;
+    String? s(Object? v) => v is String ? v : null;
+    return LoopStatus(
+      config: LoopConfig.fromWire(m['config']),
+      a11yEnabled: m['a11yEnabled'] == true,
+      a11yConnected: m['a11yConnected'] == true,
+      eventsSeen: n(m['eventsSeen']),
+      readings: n(m['readings']),
+      lastForeground: s(m['lastForeground']),
+      storageError: s(m['storageError']),
+      insideTarget: m['insideTarget'] == true,
+    );
+  }
+}
+
+/// One receipt: the shared event record (eventId, source, timestamp, state, result, error).
+class LoopEvent {
+  const LoopEvent({
+    required this.eventId,
+    required this.source,
+    required this.timestamp,
+    required this.state,
+    this.result,
+    this.error,
+    this.reason,
+    this.packageName,
+    this.updatedAt,
+  });
+
+  final String eventId;
+  final String source;
+  final DateTime timestamp;
+
+  /// CONFIRMED / TRIGGERED / SHOWN / CLOSED.
+  final String state;
+
+  /// RETURNED / BACK / DISMISSED / TIMEOUT / ABANDONED / UNAVAILABLE / SUPPRESSED / ERROR; null while open.
+  final String? result;
+  final String? error;
+  final String? reason;
+  final String? packageName;
+  final DateTime? updatedAt;
+
+  static LoopEvent? fromWire(Object? raw) {
+    if (raw is! Map) return null;
+    final id = raw['eventId'];
+    final ts = raw['timestamp'];
+    if (id is! String || ts is! num) return null;
+    String? s(Object? v) => v is String ? v : null;
+    final up = raw['updatedAt'];
+    return LoopEvent(
+      eventId: id,
+      source: s(raw['source']) ?? '',
+      timestamp: DateTime.fromMillisecondsSinceEpoch(ts.toInt()),
+      state: s(raw['state']) ?? '',
+      result: s(raw['result']),
+      error: s(raw['error']),
+      reason: s(raw['reason']),
+      packageName: s(raw['packageName']),
+      updatedAt: up is num ? DateTime.fromMillisecondsSinceEpoch(up.toInt()) : null,
+    );
+  }
+}
+
+class LoopApp {
+  const LoopApp(this.package, this.label);
+
+  final String package;
+  final String label;
+}
+
+class LoopChannel {
+  LoopChannel({MethodChannel? methods}) : _methods = methods ?? const MethodChannel('dsh/loop');
+
+  final MethodChannel _methods;
+
+  /// Null when the native side is missing or failed.
+  Future<LoopStatus?> status() async {
+    try {
+      return LoopStatus.fromWire(await _methods.invokeMethod<Object?>('status'));
+    } on Exception {
+      return null;
+    }
+  }
+
+  /// Only the given fields change. [clearTarget] sets the test app to none.
+  Future<LoopConfig?> setConfig({bool? enabled, String? targetPackage, bool clearTarget = false, int? cooldownMs}) async {
+    try {
+      final raw = await _methods.invokeMethod<Object?>('setConfig', {
+        'enabled': ?enabled,
+        if (targetPackage != null || clearTarget) 'targetPackage': targetPackage,
+        'cooldownMs': ?cooldownMs,
+      });
+      return LoopConfig.fromWire(raw);
+    } on Exception {
+      return null;
+    }
+  }
+
+  Future<List<LoopEvent>> events({int limit = 50}) async {
+    try {
+      final raw = await _methods.invokeMethod<List<Object?>>('events', {'limit': limit});
+      return [for (final e in raw ?? const []) ?LoopEvent.fromWire(e)];
+    } on Exception {
+      return const [];
+    }
+  }
+
+  Future<bool> clearEvents() async {
+    try {
+      return await _methods.invokeMethod<bool>('clearEvents') ?? false;
+    } on Exception {
+      return false;
+    }
+  }
+
+  Future<List<LoopApp>> apps() async {
+    try {
+      final raw = await _methods.invokeMethod<List<Object?>>('apps');
+      return [
+        for (final a in raw ?? const [])
+          if (a is Map && a['package'] is String) LoopApp(a['package'] as String, (a['label'] as String?) ?? a['package'] as String),
+      ];
+    } on Exception {
+      return const [];
+    }
+  }
+}
diff --git a/app/lib/ui/phone/loop_test_page.dart b/app/lib/ui/phone/loop_test_page.dart
new file mode 100644
index 0000000..2eaa455
--- /dev/null
+++ b/app/lib/ui/phone/loop_test_page.dart
@@ -0,0 +1,250 @@
+import 'dart:async';
+
+import 'package:flutter/material.dart';
+
+import '../../l10n/l10n.dart';
+import '../../loop/loop_channel.dart';
+import '../common/app_sheet.dart';
+import '../common/list_page_row.dart';
+import '../shell/page_frame.dart';
+import '../theme/app_icons.dart';
+import '../theme/theme.dart';
+import 'action_log_page.dart' show formatLogTime;
+
+/// 设置 → 手机操控 → 触发测试: pick a test app, switch the first closed loop on,
+/// read its receipts. Everything is stored on the native side (loop/LoopEngine.kt).
+class LoopTestPage extends StatefulWidget {
+  const LoopTestPage({super.key, this.channel});
+
+  final LoopChannel? channel;
+
+  static const cooldownSteps = [0, 10, 60, 300];
+
+  @override
+  State<LoopTestPage> createState() => _LoopTestPageState();
+}
+
+class _LoopTestPageState extends State<LoopTestPage> {
+  late final LoopChannel _channel = widget.channel ?? LoopChannel();
+  LoopStatus? _status;
+  List<LoopEvent> _events = const [];
+  Map<String, String> _labels = const {};
+  Timer? _poll;
+
+  @override
+  void initState() {
+    super.initState();
+    unawaited(_refresh());
+    // Receipts land while the person is in the test app; pick them up on return.
+    _poll = Timer.periodic(const Duration(seconds: 3), (_) => unawaited(_refresh()));
+  }
+
+  @override
+  void dispose() {
+    _poll?.cancel();
+    super.dispose();
+  }
+
+  Future<void> _refresh() async {
+    final status = await _channel.status();
+    final events = await _channel.events(limit: 100);
+    if (!mounted) return;
+    setState(() {
+      _status = status;
+      _events = events;
+    });
+  }
+
+  Future<void> _setEnabled(bool on) async {
+    await _channel.setConfig(enabled: on);
+    await _refresh();
+  }
+
+  Future<void> _cycleCooldown(int currentMs) async {
+    const steps = LoopTestPage.cooldownSteps;
+    final i = steps.indexOf(currentMs ~/ 1000);
+    await _channel.setConfig(cooldownMs: steps[(i + 1) % steps.length] * 1000);
+    await _refresh();
+  }
+
+  Future<void> _pickApp() async {
+    final apps = await _channel.apps();
+    if (!mounted) return;
+    _labels = {for (final a in apps) a.package: a.label};
+    final picked = await showAppSheet<String>(
+      context,
+      heightFactor: 0.75,
+      builder: (sheet) => _AppList(apps: apps, current: _status?.config.targetPackage),
+    );
+    if (picked == null) return;
+    await _channel.setConfig(targetPackage: picked);
+    await _refresh();
+  }
+
+  Future<void> _clear() async {
+    await _channel.clearEvents();
+    await _refresh();
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final l10n = context.l10n;
+    final colors = DshColors.of(context);
+    final status = _status;
+    final config = status?.config ?? const LoopConfig();
+    final target = config.targetPackage;
+    final a11y = status == null
+        ? l10n.phoneControlLoading
+        : !status.a11yEnabled
+        ? l10n.loopA11yNeeded
+        : !status.a11yConnected
+        ? l10n.loopA11yWaiting
+        : l10n.loopA11yReady;
+    return AppPage.list(
+      title: l10n.loopEntryTitle,
+      subtitle: Text(l10n.loopPageSubtitle),
+      actions: [
+        GlassIconButton(icon: AppIcons.refresh, tooltip: l10n.loopRefresh, onPressed: () => unawaited(_refresh())),
+      ],
+      children: [
+        ListPageCard(
+          children: [
+            MergeSemantics(
+              child: ListPageRow(
+                icon: AppIcons.play,
+                title: l10n.loopEnabled,
+                subtitle: l10n.loopEnabledHint,
+                subtitleMaxLines: 2,
+                onTap: status == null ? null : () => unawaited(_setEnabled(!config.enabled)),
+                trailing: Switch(
+                  value: config.enabled,
+                  onChanged: status == null ? null : (v) => unawaited(_setEnabled(v)),
+                ),
+              ),
+            ),
+            ListPageRow(
+              icon: AppIcons.appRules,
+              title: l10n.loopTargetApp,
+              subtitle: target == null ? l10n.loopTargetNone : '${_labels[target] ?? target}\n$target',
+              subtitleMaxLines: 2,
+              onTap: status == null ? null : () => unawaited(_pickApp()),
+            ),
+            ListPageRow(
+              icon: AppIcons.queued,
+              title: l10n.loopCooldown,
+              subtitle: l10n.loopCooldownHint,
+              value: l10n.loopSeconds(config.cooldownMs ~/ 1000),
+              onTap: status == null ? null : () => unawaited(_cycleCooldown(config.cooldownMs)),
+            ),
+            ListPageRow(
+              icon: status?.a11yConnected ?? false ? AppIcons.allowed : AppIcons.error,
+              iconColor: status?.a11yConnected ?? false ? colors.success : colors.warning,
+              title: a11y,
+              titleMaxLines: 2,
+              subtitle: status == null
+                  ? null
+                  : l10n.loopCounters(status.eventsSeen, status.readings, status.lastForeground ?? '-'),
+              subtitleMaxLines: 2,
+            ),
+            if (status?.storageError != null)
+              ListPageRow(
+                icon: AppIcons.error,
+                iconColor: colors.danger,
+                title: l10n.loopStorageError(status!.storageError!),
+                titleMaxLines: 3,
+              ),
+          ],
+        ),
+        const SizedBox(height: 24),
+        ListPageCard(
+          title: l10n.loopReceipts,
+          children: [
+            if (_events.isEmpty)
+              ListPageRow(icon: AppIcons.history, iconColor: colors.textTertiary, title: l10n.loopReceiptsEmpty)
+            else ...[
+              for (final e in _events) _ReceiptRow(e, label: _labels[e.packageName]),
+              ListPageRow(icon: AppIcons.clearAll, title: l10n.loopClear, onTap: () => unawaited(_clear())),
+            ],
+          ],
+        ),
+        const SizedBox(height: 24),
+      ],
+    );
+  }
+}
+
+String loopResultLabel(L10n l10n, String? result) => switch (result) {
+  'RETURNED' => l10n.loopResultReturned,
+  'BACK' => l10n.loopResultBack,
+  'DISMISSED' => l10n.loopResultDismissed,
+  'TIMEOUT' => l10n.loopResultTimeout,
+  'ABANDONED' => l10n.loopResultAbandoned,
+  'UNAVAILABLE' => l10n.loopResultUnavailable,
+  'SUPPRESSED' => l10n.loopResultSuppressed,
+  'ERROR' => l10n.loopResultError,
+  null => l10n.loopResultOpen,
+  _ => result,
+};
+
+class _ReceiptRow extends StatelessWidget {
+  const _ReceiptRow(this.event, {this.label});
+
+  final LoopEvent event;
+  final String? label;
+
+  @override
+  Widget build(BuildContext context) {
+    final colors = DshColors.of(context);
+    final (icon, color) = switch (event.result) {
+      'RETURNED' || 'BACK' => (AppIcons.allowed, colors.success),
+      'DISMISSED' || 'TIMEOUT' || 'SUPPRESSED' => (AppIcons.stopped, colors.warning),
+      'ABANDONED' || 'UNAVAILABLE' || 'ERROR' => (AppIcons.error, colors.danger),
+      _ => (AppIcons.pending, colors.textTertiary),
+    };
+    final detail = [?label ?? event.packageName, ?event.reason, ?event.error].join(' · ');
+    return ListPageRow(
+      icon: icon,
+      iconColor: color,
+      title: loopResultLabel(context.l10n, event.result),
+      subtitle: detail.isEmpty ? null : detail,
+      subtitleMaxLines: 2,
+      meta: formatLogTime(event.updatedAt ?? event.timestamp),
+    );
+  }
+}
+
+class _AppList extends StatelessWidget {
+  const _AppList({required this.apps, this.current});
+
+  final List<LoopApp> apps;
+  final String? current;
+
+  @override
+  Widget build(BuildContext context) {
+    final l10n = context.l10n;
+    return Column(
+      children: [
+        Padding(
+          padding: const EdgeInsets.fromLTRB(20, 16, 20, 8),
+          child: Text(l10n.loopPickApp, style: Theme.of(context).textTheme.titleMedium),
+        ),
+        Expanded(
+          child: apps.isEmpty
+              ? Center(child: Text(l10n.loopNoApps))
+              : ListView.builder(
+                  itemCount: apps.length,
+                  itemBuilder: (context, i) {
+                    final a = apps[i];
+                    return ListTile(
+                      title: Text(a.label),
+                      subtitle: Text(a.package),
+                      trailing: a.package == current ? const Icon(AppIcons.selected) : null,
+                      onTap: () => Navigator.pop(context, a.package),
+                    );
+                  },
+                ),
+        ),
+      ],
+    );
+  }
+}
