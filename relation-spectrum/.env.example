# 复制为 .env 后填写。也可以不填，直接在网页的“设置”里填 Key。

# ---- 大模型（二选一）----
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# 默认 claude-opus-5-5；想省钱可改成 claude-sonnet-5-5 或 claude-haiku-5-5
ANTHROPIC_MODEL=claude-opus-5-5
# low / medium / high
ANTHROPIC_EFFORT=medium

# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_MODEL=deepseek-chat

# ---- Notion（可选）----
NOTION_TOKEN=
NOTION_PARENT_PAGE_ID=
NOTION_ENTITIES_DB=
NOTION_INTERACTIONS_DB=
NOTION_CASES_DB=

# ---- 服务器 ----
PORT=8787
# 想用手机在同一个 Wi-Fi 下访问：HOST=0.0.0.0，并务必设置 ACCESS_TOKEN
HOST=127.0.0.1
ACCESS_TOKEN=
