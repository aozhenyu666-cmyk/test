# 复制为 .env 后填写。也可以不填，直接在网页的“设置”里填 Key。

# ---- GPT（OpenAI 或任何 OpenAI 兼容接口）----
OPENAI_API_KEY=
# 用 OpenAI 官方留空即可；DeepSeek 填 https://api.deepseek.com/v1，OpenRouter 填 https://openrouter.ai/api/v1
OPENAI_BASE_URL=
# 填你账号可用的模型名
OPENAI_MODEL=gpt-4o-mini
# auto（OpenAI 官方用严格 JSON Schema，其他用普通 JSON）/ schema / object
OPENAI_JSON_MODE=auto

# ---- Notion ----
NOTION_TOKEN=
NOTION_PARENT_PAGE_ID=
NOTION_ENTITIES_DB=
NOTION_INTERACTIONS_DB=
NOTION_CASES_DB=

# ---- 服务器 ----
PORT=8787
# 想用手机在同一个 Wi-Fi 下访问：HOST=0.0.0.0，并务必设置 ACCESS_TOKEN
HOST=127.0.0.1
ACCESS_TOKEN=
