<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 只连本机的 DSH Go 引擎（127.0.0.1），见 res/xml/network_security.xml -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 无障碍掉线时用「使用情况访问」兜底判断前台 App；用户在系统设置里授权 -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- 无障碍被系统关掉后自己写回去。只能用 adb / Shizuku 授予，APP 内申请不到。
         有了它就不必每次都走 Shizuku；没有时退回 Shizuku 执行 settings put。 -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <!-- 向 Shizuku 申请 shell 权限 -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <!-- 包可见性：不声明就拿不到 Live 应用的启动入口，"回到 Live"会失效 -->
    <queries>
        <package android:name="com.google.android.apps.bard" />
        <package android:name="com.google.android.googlequicksearchbox" />
        <package android:name="com.openai.chatgpt" />
        <package android:name="io.github.ccch1mneyyy.dsh_app" />
        <!-- 可选互保：判断总控/一手装没装 -->
        <package android:name="com.zongkong.app" />
        <package android:name="com.yishou.app" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.speech.tts.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".DriverApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_driver"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security"
        android:supportsRtl="true"
        android:theme="@style/Theme.Driver">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ObservationActivity" android:exported="false"
            android:excludeFromRecents="true" android:taskAffinity="com.dshdriver.app.observation"
            android:theme="@style/Theme.Driver.Card" android:windowSoftInputMode="adjustResize" />

        <!-- 断点卡 / 强提醒页：独立任务栈，盖在被切去的应用上；不进最近任务 -->
        <activity
            android:name=".CardActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity="com.dshdriver.app.card"
            android:theme="@style/Theme.Driver.Card"
            android:windowSoftInputMode="adjustResize" />

        <!-- 拦截门：拦下娱乐 App 后由无障碍服务拉起来答题。
             不进最近任务（划不掉，这是和 Curbox 那套最大的区别）、独立任务栈、singleTask 防止叠出好几层。 -->
        <activity
            android:name=".GateActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity="com.dshdriver.app.gate"
            android:theme="@style/Theme.Driver.Card"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale|locale|layoutDirection" />

        <service
            android:name=".LockService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="用户主动开启的限时专注锁定：保持切屏检测和断点提醒在后台持续运行" />
        </service>

        <service
            android:name=".WatchService"
            android:exported="false"
            android:label="@string/a11y_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/watch_service" />
        </service>

        <!-- 看门狗：无障碍被关掉、进程又被杀时，靠它定期把服务写回去（JobScheduler 最短 15 分钟） -->
        <service
            android:name=".WatchdogJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- 常驻守护：拦截开着时把进程提到前台服务级别，15 秒/60 秒查一次无障碍，
             并在无障碍掉线时立刻写回。也是 UsageStats 兜底拦截的载体。 -->
        <service
            android:name=".GuardService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="用户开启拦截或监督后，持续检查无障碍与前台应用，掉了立即恢复" />
        </service>

        <!-- 服务被系统清掉后的 5 分钟兜底闹钟 -->
        <receiver
            android:name=".GuardAlarmReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- 设备所有者（可选）：用 dpm set-device-owner 授予后，不依赖 Shizuku 也能写回无障碍 -->
        <receiver
            android:name=".DriverDeviceAdmin"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- 重启、覆盖安装后把无障碍写回来 -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
