{
  "name": "AI 参谋",
  "id": "sp-ai-assistant",
  "manifestVersion": 1,
  "version": "0.4.0",
  "minSupVersion": "14.0.0",
  "description": "手机上的 AI 参谋：张嘴定计划、到点提醒、晚间复盘生成日报；长期目标与考试倒计时；计时中离开 App 回来会问你在工作还是休息。调用 OpenAI 兼容大模型，可选连接远程 MCP。",
  "author": "local",
  "hooks": [
    "currentTaskChange"
  ],
  "permissions": [
    "http"
  ],
  "allowedHosts": [
    "api.deepseek.com",
    "dashscope.aliyuncs.com",
    "api.moonshot.cn",
    "open.bigmodel.cn",
    "api.siliconflow.cn",
    "openrouter.ai",
    "api.openai.com",
    "api.anthropic.com"
  ],
  "iFrame": true,
  "uiKit": false,
  "icon": "icon.svg"
}
