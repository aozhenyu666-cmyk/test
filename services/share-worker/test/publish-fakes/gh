#!/usr/bin/env python3
"""Fake gh for scripts/publish-smoke.mjs: `release view/create/upload/download/edit`
on ccch1mneyyy/dsh-go only. Drafts live in $FAKE_GH_ROOT/_drafts/<tag>/ (not
public); `edit --draft=false` moves them to $FAKE_GH_ROOT/<tag>/, which the
static server publishes like GitHub's releases/download/. Logged to $FAKE_LOG."""
import json
import os
import shutil
import sys

args = sys.argv[1:]
with open(os.environ["FAKE_LOG"], "a") as log:
    log.write("gh " + " ".join(args) + "\n")
if args[0] == "api":
    # `gh api --paginate …` (scripts/github-downloads.sh): the pages in $FAKE_GH_API, one JSON array each.
    assert args[1] == "--paginate" and args[2].startswith("repos/ccch1mneyyy/dsh-go/releases"), args
    sys.stdout.write(open(os.environ["FAKE_GH_API"], encoding="utf-8").read())
    sys.exit(0)
assert args[0] == "release", args
ROOT = os.environ["FAKE_GH_ROOT"]
cmd, tag, rest = args[1], args[2], args[3:]
assert rest[rest.index("--repo") + 1] == "ccch1mneyyy/dsh-go"
VALUED = {"--repo", "--title", "--notes-file", "--pattern", "--dir", "--json"}


def find():
    for draft, d in ((True, os.path.join(ROOT, "_drafts", tag)), (False, os.path.join(ROOT, tag))):
        if os.path.isdir(d):
            return d, draft
    return None, None


def paths():
    out, skip = [], False
    for a in rest:
        if skip:
            skip = False
        elif a in VALUED:
            skip = True
        elif not a.startswith("-"):
            out.append(a)
    return out


d, draft = find()
if cmd == "view":
    if not d:
        print("release not found", file=sys.stderr)
        sys.exit(1)
    assets = [{"name": n, "size": os.path.getsize(os.path.join(d, n))} for n in sorted(os.listdir(d)) if n != ".release.json"]
    print(json.dumps({"isDraft": draft, "assets": assets}))
elif cmd == "create":
    assert not d, "release exists"
    assert "--draft" in rest, "created published"
    d = os.path.join(ROOT, "_drafts", tag)
    os.makedirs(d)
    notes = open(rest[rest.index("--notes-file") + 1], encoding="utf-8").read()
    release = {"title": rest[rest.index("--title") + 1], "prerelease": "--prerelease" in rest, "notes": notes}
    json.dump(release, open(os.path.join(d, ".release.json"), "w"), ensure_ascii=False)
    for f in paths():
        shutil.copyfile(f, os.path.join(d, os.path.basename(f)))
elif cmd == "upload":
    assert d, "no release"
    for f in paths():
        target = os.path.join(d, os.path.basename(f))
        assert "--clobber" in rest or not os.path.exists(target), "asset exists"
        shutil.copyfile(f, target)
elif cmd == "download":
    assert d, "no release"
    name = rest[rest.index("--pattern") + 1]
    shutil.copyfile(os.path.join(d, name), os.path.join(rest[rest.index("--dir") + 1], name))
elif cmd == "edit":
    assert d and draft and "--draft=false" in rest
    shutil.move(d, os.path.join(ROOT, tag))
else:
    sys.exit(f"fake gh: release {cmd}?")
