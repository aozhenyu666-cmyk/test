#!/usr/bin/env python3
"""Fake coscli for scripts/publish-smoke.mjs:
  coscli cp SRC cos://BUCKET/KEY --meta "Content-Type:T#Cache-Control:C" -c CFG
checks the config file, then copies SRC to $FAKE_CN_ROOT/KEY. Logged to $FAKE_LOG."""
import os
import shutil
import stat
import sys

args = sys.argv[1:]
with open(os.environ["FAKE_LOG"], "a") as log:
    log.write("coscli " + " ".join(args) + "\n")
assert args[0] == "cp", args
src, dst = args[1], args[2]
opt = lambda name: args[args.index(name) + 1]
cfg = opt("-c")
assert stat.S_IMODE(os.stat(cfg).st_mode) == 0o600, "config file not private"
text = open(cfg).read()
bucket, region = os.environ["FAKE_BUCKET"], os.environ["FAKE_REGION"]
assert f"secretid: {os.environ['FAKE_KEY_ID']}\n" in text and f"secretkey: {os.environ['FAKE_KEY_SECRET']}\n" in text, "wrong key"
assert f"- name: {bucket}\n" in text and f"region: {region}\n" in text and f"endpoint: cos.{region}.myqcloud.com\n" in text
meta = opt("--meta")
assert meta.startswith("Content-Type:") and "#Cache-Control:" in meta, meta
prefix = f"cos://{bucket}/"
assert dst.startswith(prefix), dst
out = os.path.join(os.environ["FAKE_CN_ROOT"], dst[len(prefix):])
os.makedirs(os.path.dirname(out), exist_ok=True)
shutil.copyfile(src, out)
