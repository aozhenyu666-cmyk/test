#!/bin/bash
# Minimal pkill for Git Bash on Windows: match a node.exe command-line fragment and kill it.
pat="$*"
pat="${pat#-f }"
pat="${pat#-9 }"
powershell -NoProfile -Command "\$p='$pat'; Get-CimInstance Win32_Process | Where-Object { \$_.Name -eq 'node.exe' -and \$_.CommandLine -and \$_.CommandLine.Contains(\$p) } | ForEach-Object { Stop-Process -Id \$_.ProcessId -Force -ErrorAction SilentlyContinue }" >/dev/null 2>&1
exit 0
