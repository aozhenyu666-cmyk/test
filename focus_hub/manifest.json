{
  "schema_version": 1,
  "toolpkg_id": "local.focus_hub",
  "version": "0.6.0",
  "api_version": "1.0.0",
  "main": "dist/main.js",
  "display_name": {
    "zh": "主控台",
    "en": "Focus Hub",
    "default": "Focus Hub"
  },
  "description": {
    "zh": "陪伴式主控台：首页是她，会话页一个主入口，系统页收纳体检和工作流，省流页量出上下文花在哪并提供可撤销的精简。附带进展入口、打卡和跳转工具。不冻结、不解冻、不触发工作流。",
    "en": "Companion-style hub: mood, four actions, daily focus strip; chats and system pages; progress entry and companion check-ins.",
    "default": "Companion-style hub."
  },
  "enabled_by_default": false,
  "subpackages": [
    {
      "id": "focus_hub_data",
      "entry": "dist/packages/focus_hub_data.js",
      "enabled_by_default": true,
      "display_name": {
        "zh": "主控台数据",
        "en": "Focus Hub Data"
      },
      "description": {
        "zh": "给 AI 用的只读工具：读取看板快照。",
        "en": "Read-only tool for the AI: read the dashboard snapshot."
      }
    },
    {
      "id": "focus_hub_progress",
      "entry": "dist/packages/focus_hub_progress.js",
      "enabled_by_default": true,
      "display_name": {
        "zh": "用户进展",
        "en": "User Progress"
      },
      "description": {
        "zh": "用户进展的统一入口：对话里的 AI 记录用户亲口说的进展，判断和提醒前先读。只追加写 progress 目录。",
        "en": "Single entry for user-stated progress. Append-only."
      }
    },
    {
      "id": "focus_hub_nav",
      "entry": "dist/packages/focus_hub_nav.js",
      "enabled_by_default": true,
      "display_name": {
        "zh": "主控台跳转",
        "en": "Focus Hub Navigation"
      },
      "description": {
        "zh": "工作流或 AI 用：打开主控台页面，或在主界面打开指定对话。只做页面跳转。",
        "en": "Open the Focus Hub page or a specific chat. Navigation only."
      }
    },
    {
      "id": "focus_hub_slim",
      "entry": "dist/packages/focus_hub_slim.js",
      "enabled_by_default": false,
      "display_name": {
        "zh": "省流报告",
        "en": "Context Diet Report"
      },
      "description": {
        "zh": "只读：哪些对话、工具包、角色卡最耗上下文。",
        "en": "Read-only context-cost report."
      }
    }
  ],
  "resources": [
    {
      "key": "workflow_checkin",
      "path": "resources/workflow_checkin.json",
      "mime": "application/json"
    }
  ],
  "workflow_templates": [
    {
      "id": "companion_checkin",
      "display_name": {
        "zh": "陪伴打卡（每小时）",
        "en": "Companion Check-in (hourly)"
      },
      "description": {
        "zh": "每小时让她来找你：语音 + 弹出主控台 + 待回应。深夜和刚找过时自动跳过。",
        "en": "Hourly companion check-in with voice and popup."
      },
      "resource_key": "workflow_checkin"
    }
  ],
  "workspace_templates": []
}
